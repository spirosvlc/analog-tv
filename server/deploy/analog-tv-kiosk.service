[Unit]
Description=Analog TV Chromium kiosk
After=graphical.target analog-tv.service
Wants=analog-tv.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
ExecStart=/usr/bin/chromium --kiosk --autoplay-policy=no-user-gesture-required --disable-session-crashed-bubble --disable-infobars http://127.0.0.1:8080/
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target

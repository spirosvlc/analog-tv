# Copy to /addon_configs/local_analog_tv/auth.env (Home Assistant).
# Do not commit your actual values.
ANALOG_ADMIN_EMAIL=your-google-account@gmail.com
ANALOG_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_OAUTH_CLIENT_ID
ANALOG_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_WEB_OAUTH_CLIENT_SECRET
ANALOG_GOOGLE_REDIRECT_URI=https://your-domain.example/auth/google/callback
ANALOG_PUBLIC_BASE_URL=https://your-domain.example
ANALOG_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ANALOG_COOKIE_SECURE=true
